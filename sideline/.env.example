# --- Required for the Next.js app (set in Vercel Environment Variables for Production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: supabase/seed-teams.ts (never commit real keys)
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL: use your canonical production origin (e.g. https://app.example.com).
# On Vercel, omit for preview URLs (VERCEL_URL is used at runtime for server origin helpers) or
# set explicitly when using a custom domain so server-side URL logic matches the real host.
# Supabase Auth: add these redirect URL patterns in the Supabase project (Auth → URL Configuration)
# for the production Supabase project: {origin}/auth/callback, {origin}/auth/confirm, {origin}/reset-password
# (add both custom domain and *.vercel.app if you use both).
# Password recovery: resetPasswordForEmail redirectTo is {origin}/auth/callback?type=recovery — whitelist
# /auth/callback for each environment (e.g. http://localhost:3000/auth/callback, https://<project>.vercel.app/auth/callback).
NEXT_PUBLIC_SITE_URL=
