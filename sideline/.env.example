NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: supabase/seed-teams.ts (never commit real keys)
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used for OAuth redirect callbacks (e.g. https://yourdomain.com).
# On Vercel, defaults to VERCEL_URL when unset.
# Supabase redirect allowlist should include {SITE_URL}/auth/callback (OAuth)
# and {SITE_URL}/auth/confirm (email confirmation).
NEXT_PUBLIC_SITE_URL=